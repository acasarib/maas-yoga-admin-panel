NODE_ENV=development

POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=maasyoga
POSTGRES_PORT=5432

FRONTEND_PORT=3001
FRONTEND_HOST=http://localhost:3001
BACKEND_PORT=3002
BACKEND_HOST=http://localhost:3002/
BACKEND_TOKEN_SECRET=123
BACKEND_TOKEN_EXPIRATION_TIME_MILISECONDS=86400
ALLOWED_ORIGINS=*
REACT_APP_HEALTHCHECK=http://localhost:3002/api/v1/healthcheck
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_API_KEY=your_google_api_key
USE_SSL_CERTIFICATE=true
SSL_CERTIFICATE_PATH=./certificates/cert.pem
SSL_CERTIFICATE_KEY_PATH=./certificates/key.pem

# Configuración AFIP - Facturación electrónica
AFIP_CUIT=20XXXXXXXXX
AFIP_NOMBRE=Nombre o Razón Social del Emisor
AFIP_PUNTO_VENTA=1
AFIP_ENV=homologation
# AFIP_ENV puede ser 'homologation' o 'production'
AFIP_REGIMEN=monotributo
# AFIP_REGIMEN: 'responsable' (Responsable Inscripto, Factura A con IVA) o 'monotributo' (Factura B sin IVA)
AFIP_CERT_PATH=./certs/maasyoga.crt
AFIP_KEY_PATH=./certs/maasyoga.key

# Configuración de email
# Opción 1 - SMTP (Gmail u otro)
SMTP_ENABLED=false
# SMTP_ENABLED=true para usar SMTP, false para usar Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=maasyoga@gmail.com
SMTP_PASS=
# Si usas Gmail, SMTP_PASS debe ser una "Contraseña de aplicación" (no la clave de la cuenta)

# Opción 2 - Brevo (recomendado, sin config extra de Gmail)
BREVO_API_KEY=
BREVO_FROM=maasyoga@gmail.com

SWAGGER_ENABLED=true
SWAGGER_SERVER_URL=http://localhost:3002
